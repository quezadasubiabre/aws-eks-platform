{
  "title": "GPU Node Metrics",
  "uid": "node-container-gpu",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["platform", "infrastructure", "gpu"],
  "panels": [
    {
      "id": 1,
      "title": "GPU node: CPU & RAM",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "GPU node CPU usage",
      "type": "timeseries",
      "description": "Filtered by the GPU node's IP - update if the node is recreated.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\", instance=\"10.0.49.215:9100\"}[5m]))",
          "legendFormat": "GPU node CPU usage"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 3,
      "title": "GPU node memory usage",
      "type": "timeseries",
      "description": "Same IP filter as the CPU panel.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "1 - (node_memory_MemAvailable_bytes{instance=\"10.0.49.215:9100\"} / node_memory_MemTotal_bytes{instance=\"10.0.49.215:9100\"})",
          "legendFormat": "GPU node memory usage"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 4,
      "title": "GPU node: pods running on it",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false
    },
    {
      "id": 5,
      "title": "Memory by pod (GPU node only)",
      "type": "timeseries",
      "description": "vLLM's container next to the DaemonSets sharing this node.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 10 },
      "targets": [
        {
          "expr": "sum by (namespace, pod) (container_memory_working_set_bytes{container!=\"\", node=\"ip-10-0-49-215.eu-west-1.compute.internal\"})",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 6,
      "title": "CPU by pod (GPU node only)",
      "type": "timeseries",
      "description": "Same node filter as the memory panel.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 10 },
      "targets": [
        {
          "expr": "sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{container!=\"\", node=\"ip-10-0-49-215.eu-west-1.compute.internal\"}[5m]))",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 7,
      "title": "GPU hardware",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "collapsed": false
    },
    {
      "id": 8,
      "title": "GPU memory: used vs. free vs. total",
      "type": "timeseries",
      "description": "Total is computed as used + free (DCGM has no total metric).",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_FB_USED",
          "legendFormat": "used ({{modelName}})"
        },
        {
          "expr": "DCGM_FI_DEV_FB_FREE",
          "legendFormat": "free ({{modelName}})"
        },
        {
          "expr": "DCGM_FI_DEV_FB_USED + DCGM_FI_DEV_FB_FREE",
          "legendFormat": "total ({{modelName}})"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "decmbytes" } }
    },
    {
      "id": 9,
      "title": "GPU compute utilization",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_UTIL",
          "legendFormat": "GPU {{gpu}} ({{modelName}})"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 } }
    }
  ]
}
